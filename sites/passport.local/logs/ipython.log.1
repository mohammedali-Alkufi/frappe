from frappe.permissions import add_permission, update_permission_property

# ============================================================
# 1. ENSURE ALL ROLES EXIST
# ============================================================
roles = [
    "Passport Data Entry Clerk",
    "Passport Manager",
    "Passport Administrator"
]

for r in roles:
    if not frappe.db.exists("Role", r):
        role_doc = frappe.new_doc("Role")
        role_doc.role_name = r
        role_doc.desk_access = 1
        role_doc.insert(ignore_permissions=True)

# ============================================================
# 2. CONFIGURE DOCTYPE PERMISSIONS
# ============================================================
# Core DocTypes required to prevent boot/permission errors
core_doctypes = ["Email Account", "Communication", "File", "DocType"]
for dt in core_doctypes:
    for r in roles:
        try:
            add_permission(dt, r, 0)
            update_permission_property(dt, r, 0, "read", 1)
        except Exception:
            pass

# Permissions for Passport Application
# Clerk: Read, Write, Create (Level 0)
add_permission("Passport Application", "Passport Data Entry Clerk", 0)
update_permission_property("Passport Application", "Passport Data Entry Clerk", 0, "read", 1)
update_permission_property("Passport Application", "Passport Data Entry Clerk", 0, "write", 1)
update_permission_property("Passport Application", "Passport Data Entry Clerk", 0, "create", 1)

# Manager: Read, Write (Level 0)
add_permission("Passport Application", "Passport Manager", 0)
update_permission_property("Passport Application", "Passport Manager", 0, "read", 1)
update_permission_property("Passport Application", "Passport Manager", 0, "write", 1)

# Administrator: Full Access + Submit
add_permission("Passport Application", "Passport Administrator", 0)
update_permission_property("Passport Application", "Passport Administrator", 0, "read", 1)
update_permission_property("Passport Application", "Passport Administrator", 0, "write", 1)
update_permission_property("Passport Application", "Passport Administrator", 0, "create", 1)
update_permission_property("Passport Application", "Passport Administrator", 0, "submit", 1)
update_permission_property("Passport Application", "Passport Administrator", 0, "cancel", 1)

# ============================================================
# 3. BUILD / OVERWRITE WORKFLOW STATE MACHINE
# ============================================================
workflow_name = "Passport Approval Workflow"

# Ensure Workflow States exist
states_data = [
    {"state": "Draft", "doc_status": 0},
    {"state": "Pending Manager Review", "doc_status": 0},
    {"state": "Pending Admin Authorization", "doc_status": 0},
    {"state": "Issued / Ready to Print", "doc_status": 1},
    {"state": "Rejected", "doc_status": 2},
]

for s in states_data:
    if not frappe.db.exists("Workflow State", s["state"]):
        ws = frappe.new_doc("Workflow State")
        ws.workflow_state_name = s["state"]
        ws.insert(ignore_permissions=True)

# Delete existing workflow if present to ensure clean rebuild
if frappe.db.exists("Workflow", workflow_name):
    frappe.delete_doc("Workflow", workflow_name, ignore_permissions=True)

wf = frappe.new_doc("Workflow")
wf.workflow_name = workflow_name
wf.document_type = "Passport Application"
wf.workflow_state_field = "workflow_state"
wf.is_active = 1

# Populate States table
for s in states_data:
    wf.append("states", {
        "state": s["state"],
        "doc_status": s["doc_status"],
        "allow_edit": "Passport Data Entry Clerk" if s["state"] == "Draft" else "System Manager"
    })

# Populate Transitions table
transitions = [
    {
        "state": "Draft",
        "action": "Submit for Verification",
        "next_state": "Pending Manager Review",
        "allowed": "Passport Data Entry Clerk"
    },
    {
        "state": "Pending Manager Review",
        "action": "Approve",
        "next_state": "Pending Admin Authorization",
        "allowed": "Passport Manager"
    },
    {
        "state": "Pending Manager Review",
        "action": "Send Back for Correction",
        "next_state": "Draft",
        "allowed": "Passport Manager"
    },
    {
        "state": "Pending Admin Authorization",
        "action": "Final Authorize & Issue",
        "next_state": "Issued / Ready to Print",
        "allowed": "Passport Administrator"
    },
    {
        "state": "Pending Admin Authorization",
        "action": "Reject",
        "next_state": "Draft",
        "allowed": "Passport Administrator"
    }
]

for t in transitions:
    wf.append("transitions", t)

wf.insert(ignore_permissions=True)
frappe.db.commit()

print(">>> [SUCCESS] All permissions, roles, and workflow transitions configured via CLI!")
exit()
