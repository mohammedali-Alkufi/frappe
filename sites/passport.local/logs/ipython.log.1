cs_code = """
frappe.ui.form.on('Passport Application', {
    refresh(frm) {
        // Listen for signature pad completion from new tab
        if (!window.has_passport_signature_listener) {
            window.addEventListener('message', function(event) {
                if (event.data && event.data.type === 'PASSPORT_SIGNATURE_SAVED') {
                    if (cur_frm && cur_frm.doc.name === event.data.docname) {
                        frappe.show_alert({
                            message: __('تم استلام التوقيع وتحديث السجل!'),
                            indicator: 'green'
                        });
                        cur_frm.reload_doc();
                    }
                }
            });
            window.has_passport_signature_listener = true;
        }

        // Add clickable link/button right beside or under the signature field
        if (!frm.is_new()) {
            frm.add_custom_button(__('✍️ فتح شاشة التوقيع في نافذة جديدة'), () => {
                const sign_url = `/passport_sign?docname=${encodeURIComponent(frm.doc.name)}`;
                window.open(sign_url, '_blank');
            }, __('إجراءات التوقيع'));
        }

        // Handle button visibility
        const state = frm.doc.workflow_state || 'Draft';
        const roles = frappe.user_roles;
        const is_clerk = roles.includes('Passport Data Entry Clerk') || roles.includes('System Manager');
        const is_manager = roles.includes('Passport Manager') || roles.includes('System Manager');
        const is_admin = roles.includes('Passport Administrator') || roles.includes('System Manager');

        if (frm.fields_dict['btn_clerk_submit']) {
            frm.toggle_display('btn_clerk_submit', state === 'Draft' && is_clerk);
            frm.toggle_display('btn_manager_approve', state === 'Pending Manager Review' && is_manager);
            frm.toggle_display('btn_manager_send_back', state === 'Pending Manager Review' && is_manager);
            frm.toggle_display('btn_admin_issue', state === 'Pending Admin Authorization' && is_admin);
            frm.toggle_display('btn_print_booklet', state === 'Issued / Ready to Print' || frm.doc.docstatus === 1);
        }
    },

    btn_clerk_submit(frm) { apply_action(frm, 'Submit for Verification'); },
    btn_manager_approve(frm) { apply_action(frm, 'Approve'); },
    btn_manager_send_back(frm) { apply_action(frm, 'Send Back for Correction'); },
    btn_admin_issue(frm) { apply_action(frm, 'Final Authorize & Issue'); },
    btn_print_booklet(frm) {
        const url = frappe.urllib.get_full_url(
            `/printview?doctype=Passport%20Application&name=${encodeURIComponent(frm.doc.name)}&format=Passport%20TD3%20Booklet%20Page&no_letterhead=1`
        );
        window.open(url, '_blank');
    }
});

function apply_action(frm, action_name) {
    frappe.confirm(`هل أنت متأكد من تنفيذ الإجراء: "${action_name}"؟`, () => {
        frappe.xcall('frappe.model.workflow.apply_workflow', {
            doc: frm.doc,
            action: action_name
        }).then(() => frm.reload_doc());
    });
}
"""

script_name = "Passport Application Action Buttons"
if frappe.db.exists("Client Script", script_name):
    cs = frappe.get_doc("Client Script", script_name)
else:
    cs = frappe.new_doc("Client Script")
    cs.name = script_name
    cs.dt = "Passport Application"

cs.script = cs_code
cs.enabled = 1
cs.save(ignore_permissions=True)

frappe.db.commit()
print(">>> [SUCCESS] Interactive signature pad and parent-tab listener installed!")
exit()
