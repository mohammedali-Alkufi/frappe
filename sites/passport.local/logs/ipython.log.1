    justify-content: space-between;
    margin-top: 0.5mm;
}
.signature-img {
    max-height: 8mm;
    max-width: 28mm;
}

/* MRZ Section */
.mrz-box {
    margin-top: 0.5mm;
    padding-top: 0.5mm;
    font-family: "Courier New", Courier, monospace;
    font-size: 9.3pt;
    line-height: 1.12;
    letter-spacing: 1.7px;
    font-weight: 700;
    white-space: pre;
    color: #000;
