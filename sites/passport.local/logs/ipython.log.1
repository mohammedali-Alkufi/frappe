    font-size: 5.5pt;
    color: #4b5563;
}

/* Meta Bar */
.meta-bar {
    display: flex;
    justify-content: space-between;
    font-size: 5.2pt;
    margin-top: 1mm;
    margin-bottom: 1.2mm;
    padding: 0 1mm;
}
.meta-item {
    display: flex;
    gap: 3px;
    align-items: baseline;
}
.meta-label {
    color: #374151;
    font-weight: 600;
}
.meta-val {
    font-weight: 800;
    font-size: 6.5pt;
}
.meta-val-red {
    color: #b91c1c;
    font-weight: 800;
    font-size: 7.5pt;
    letter-spacing: 0.5px;
}

/* Main Body Layout */
.main-body {
    display: flex;
    flex-direction: row;
    height: 53mm;
}

/* Photo Column */
.photo-col {
    width: 32mm;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.photo-frame {
    width: 30mm;
    height: 40mm;
