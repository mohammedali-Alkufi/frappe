from frappe.permissions import add_permission, update_permission_property

# ============================================================
# 1. ENSURE USERS HAVE THEIR RESPECTIVE ROLES
# ============================================================
user_role_map = {
    "clerk@passport.local": "Passport Data Entry Clerk",
    "manager@passport.local": "Passport Manager",
    "admin_user@passport.local": "Passport Administrator"
}

for email, role in user_role_map.items():
    if frappe.db.exists("User", email):
        u = frappe.get_doc("User", email)
        assigned = [r.role for r in u.roles]
        if role not in assigned:
            u.append("roles", {"role": role})
            u.save(ignore_permissions=True)
            print(f">>> Added role '{role}' to {email}")

# ============================================================
# 2. ENSURE ALL WORKFLOW ACTION MASTERS EXIST
# ============================================================
actions = [
    "Submit for Verification",
    "Approve",
    "Send Back for Correction",
    "Final Authorize & Issue",
    "Reject"
]

for act in actions:
    if not frappe.db.exists("Workflow Action Master", act):
        a = frappe.new_doc("Workflow Action Master")
        a.workflow_action_name = act
        a.insert(ignore_permissions=True)

# ============================================================
# 3. ENSURE ALL WORKFLOW STATES EXIST
# ============================================================
states_info = [
    ("Draft", 0),
    ("Pending Manager Review", 0),
    ("Pending Admin Authorization", 0),
    ("Issued / Ready to Print", 1),
    ("Rejected", 2)
]

for state_name, doc_status in states_info:
    if not frappe.db.exists("Workflow State", state_name):
        ws = frappe.new_doc("Workflow State")
        ws.workflow_state_name = state_name
        ws.insert(ignore_permissions=True)

# ============================================================
# 4. RECREATE WORKFLOW WITH PROPER EDIT & TRANSITION RULES
# ============================================================
wf_name = "Passport Approval Workflow"
if frappe.db.exists("Workflow", wf_name):
    frappe.delete_doc("Workflow", wf_name, ignore_permissions=True)

wf = frappe.new_doc("Workflow")
wf.workflow_name = wf_name
wf.document_type = "Passport Application"
wf.workflow_state_field = "workflow_state"
wf.is_active = 1
# Don't override status so doc_status transitions operate smoothly
wf.dont_override_status = 0

# States Table:
# Allow edit MUST include the role executing transitions in that state
wf.append("states", {"state": "Draft", "doc_status": 0, "allow_edit": "Passport Data Entry Clerk"})
wf.append("states", {"state": "Pending Manager Review", "doc_status": 0, "allow_edit": "Passport Manager"})
wf.append("states", {"state": "Pending Admin Authorization", "doc_status": 0, "allow_edit": "Passport Administrator"})
wf.append("states", {"state": "Issued / Ready to Print", "doc_status": 1, "allow_edit": "Passport Administrator"})
wf.append("states", {"state": "Rejected", "doc_status": 2, "allow_edit": "Passport Administrator"})

# Transitions Table:
wf.append("transitions", {
    "state": "Draft",
    "action": "Submit for Verification",
    "next_state": "Pending Manager Review",
    "allowed": "Passport Data Entry Clerk"
})
wf.append("transitions", {
    "state": "Pending Manager Review",
    "action": "Approve",
    "next_state": "Pending Admin Authorization",
    "allowed": "Passport Manager"
})
wf.append("transitions", {
    "state": "Pending Manager Review",
    "action": "Send Back for Correction",
    "next_state": "Draft",
    "allowed": "Passport Manager"
})
wf.append("transitions", {
    "state": "Pending Admin Authorization",
    "action": "Final Authorize & Issue",
    "next_state": "Issued / Ready to Print",
    "allowed": "Passport Administrator"
})
wf.append("transitions", {
    "state": "Pending Admin Authorization",
    "action": "Reject",
    "next_state": "Draft",
    "allowed": "Passport Administrator"
})

wf.insert(ignore_permissions=True)

# ============================================================
# 5. RE-ALIGN ALL EXISTING PASSPORT APPLICATION DOCUMENTS
# ============================================================
applications = frappe.get_all("Passport Application", fields=["name", "workflow_state", "docstatus"])
for app in applications:
    d = frappe.get_doc("Passport Application", app.name)
    # If state is missing or corrupted, normalize it
    if not d.workflow_state or d.workflow_state not in [s[0] for s in states_info]:
        d.workflow_state = "Pending Manager Review"
        d.docstatus = 0
        d.save(ignore_permissions=True)
        print(f">>> Reset document {d.name} state to 'Pending Manager Review'")

frappe.db.commit()
print(">>> [SUCCESS] Workflow, transitions, and documents fully aligned!")
exit()
