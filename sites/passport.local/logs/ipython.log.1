from frappe.utils.password import update_password

email = "clerk@passport.local"

# 1. Fetch user or create if somehow missing
if not frappe.db.exists("User", email):
    user = frappe.new_doc("User")
    user.email = email
    user.first_name = "Clerk"
    user.save(ignore_permissions=True)
else:
    user = frappe.get_doc("User", email)

# 2. Ensure account is fully active and is a Desk user
user.enabled = 1
user.user_type = "System User"
user.send_welcome_email = 0

# 3. Ensure essential roles exist on user
roles = ["Passport Data Entry Clerk", "Desk User", "Employee"]
for r in roles:
    if frappe.db.exists("Role", r) and not any(ur.role == r for ur in user.roles):
        user.append("roles", {"role": r})

user.save(ignore_permissions=True)

# 4. Directly update password in the __Auth table
