# 2. Update Client Script to embed the direct link inside the field area
cs_code = """
frappe.ui.form.on('Passport Application', {
    refresh(frm) {
        // Set up the listener for when the signature tab finishes
        if (!window.has_passport_signature_listener) {
            window.addEventListener('message', function(event) {
                if (event.data && event.data.type === 'PASSPORT_SIGNATURE_SAVED') {
                    if (cur_frm && cur_frm.doc.name === event.data.docname) {
                        frappe.show_alert({
                            message: __('تم استلام التوقيع بنجاح!'),
                            indicator: 'green'
                        });
                        cur_frm.reload_doc();
                    }
                }
            });
            window.has_passport_signature_listener = true;
        }

        // Render the clickable text link under the signature label
        render_signature_link(frm);

        // Control bottom workflow buttons
        const state = frm.doc.workflow_state || 'Draft';
        const roles = frappe.user_roles;
        const is_clerk = roles.includes('Passport Data Entry Clerk') || roles.includes('System Manager');
        const is_manager = roles.includes('Passport Manager') || roles.includes('System Manager');
        const is_admin = roles.includes('Passport Administrator') || roles.includes('System Manager');

        if (frm.fields_dict['btn_clerk_submit']) {
            frm.toggle_display('btn_clerk_submit', state === 'Draft' && is_clerk);
            frm.toggle_display('btn_manager_approve', state === 'Pending Manager Review' && is_manager);
            frm.toggle_display('btn_manager_send_back', state === 'Pending Manager Review' && is_manager);
            frm.toggle_display('btn_admin_issue', state === 'Pending Admin Authorization' && is_admin);
            frm.toggle_display('btn_print_booklet', state === 'Issued / Ready to Print' || frm.doc.docstatus === 1);
        }
    }
});

function render_signature_link(frm) {
    const field = frm.fields_dict['applicant_signature'];
    if (!field) return;

    // Remove existing custom link box if reloaded
    field.$wrapper.find('.custom-sign-link-box').remove();

    let preview_html = '';
    if (frm.doc.applicant_signature) {
        preview_html = `
            <div style="margin-top: 8px; border: 1px dashed #cbd5e1; padding: 6px; border-radius: 6px; background: #fff; width: fit-content;">
                <img src="${frm.doc.applicant_signature}" style="max-height: 55px; max-width: 180px; display: block;" />
            </div>
        `;
    }

    const link_box = $(`
        <div class="custom-sign-link-box" style="margin-top: 6px;">
            <a href="javascript:void(0);" class="btn-open-sign-tab" style="
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: #2563eb;
                font-weight: 600;
                font-size: 13px;
                text-decoration: underline;
                cursor: pointer;
            ">
                <i class="fa fa-pencil-square-o"></i> اضغط هنا لفتح لوحة التوقيع في نافذة جديدة
            </a>
            ${preview_html}
        </div>
    `);

    link_box.find('.btn-open-sign-tab').on('click', function() {
        if (frm.is_new()) {
            frappe.msgprint(__('يرجى حفظ المعاملة أولاً قبل فتح شاشة التوقيع'));
            return;
        }
        const sign_url = `/passport_sign?docname=${encodeURIComponent(frm.doc.name)}`;
        window.open(sign_url, '_blank');
    });

    field.$wrapper.append(link_box);
}

// Button actions
function apply_action(frm, action_name) {
    frappe.confirm(`هل أنت متأكد من تنفيذ الإجراء: "${action_name}"؟`, () => {
        frappe.xcall('frappe.model.workflow.apply_workflow', {
            doc: frm.doc,
            action: action_name
        }).then(() => frm.reload_doc());
    });
}
"""

script_name = "Passport Application Action Buttons"
cs = frappe.get_doc("Client Script", script_name)
cs.script = cs_code
cs.save(ignore_permissions=True)

frappe.db.commit()
print(">>> [SUCCESS] Signature field converted to interactive text link!")
exit()
