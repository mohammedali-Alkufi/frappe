            min-height: 100vh;
        }
        .container {
            background: #ffffff;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 650px;
            text-align: center;
        }
        h2 { margin-top: 0; color: #0f172a; font-size: 20px; }
        p { color: #64748b; font-size: 14px; margin-bottom: 20px; }
        .canvas-container {
            border: 2px dashed #94a3b8;
            border-radius: 8px;
            background: #ffffff;
            position: relative;
            touch-action: none;
        }
        canvas {
            width: 100%;
            height: 240px;
            display: block;
            cursor: crosshair;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }
        button {
            padding: 10px 20px;
            font-size: 15px;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-save {
            background: #16a34a;
            color: #ffffff;
        }
        .btn-save:hover { background: #15803d; }
        .btn-clear {
            background: #e2e8f0;
            color: #334155;
        }
        .btn-clear:hover { background: #cbd5e1; }
        .btn-cancel {
            background: #fee2e2;
            color: #991b1b;
        }
        .btn-cancel:hover { background: #fecaca; }
        #status-msg {
            margin-top: 15px;
            font-size: 14px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>لوحة التوقيع الرقمي (Digital Signature Pad)</h2>
        <p>يرجى كتابة التوقيع داخل الإطار أدناه ثم الضغط على "حفظ وإغلاق"</p>

        <div class="canvas-container">
            <canvas id="signature-canvas" width="600" height="240"></canvas>
        </div>

        <div id="status-msg"></div>

        <div class="btn-group">
            <button class="btn-save" id="btn-save" onclick="saveSignature()">💾 حفظ التوقيع والعودة (Save & Return)</button>
            <button class="btn-clear" onclick="clearCanvas()">مسح (Clear)</button>
            <button class="btn-cancel" onclick="window.close()">إلغاء (Cancel)</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('signature-canvas');
        const ctx = canvas.getContext('2d');
        const statusMsg = document.getElementById('status-msg');
        let isDrawing = false;
        let hasDrawn = false;

        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (clientX - rect.left) * (canvas.width / rect.width),
                y: (clientY - rect.top) * (canvas.height / rect.height)
            };
        }

        function startDrawing(e) {
            e.preventDefault();
            isDrawing = true;
            hasDrawn = true;
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(pos.x, pos.y);
        }

        function draw(e) {
            if (!isDrawing) return;
            e.preventDefault();
            const pos = getPos(e);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
        }

        function stopDrawing(e) {
            if (isDrawing) {
                isDrawing = false;
                ctx.closePath();
            }
        }

        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDrawing);

        canvas.addEventListener('touchstart', startDrawing, { passive: false });
        canvas.addEventListener('touchmove', draw, { passive: false });
        canvas.addEventListener('touchend', stopDrawing);

        function clearCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            hasDrawn = false;
            statusMsg.innerText = '';
        }

        function getDocName() {
            const params = new URLSearchParams(window.location.search);
            return params.get('docname');
        }

        async function saveSignature() {
            if (!hasDrawn) {
                alert('يرجى رسم التوقيع أولاً!');
                return;
            }

            const docname = getDocName();
            if (!docname) {
                alert('خطأ: لم يتم تحديد مستند صالح.');
                return;
            }

            const dataUrl = canvas.toDataURL('image/png');
            const saveBtn = document.getElementById('btn-save');
            saveBtn.disabled = true;
            statusMsg.style.color = '#0284c7';
            statusMsg.innerText = 'جاري رفع التوقيع وتحديث البيانات...';

            try {
                // Upload image via Frappe Upload File API
                const response = await fetch('/api/method/upload_file', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                        'X-Frappe-CSRF-Token': getCookie('csrf_token')
                    },
                    body: JSON.stringify({
                        doctype: 'Passport Application',
                        docname: docname,
                        filedata: dataUrl.split(',')[1],
                        filename: `sig_${docname}.png`,
                        from_form: 1,
                        is_private: 0
                    })
                });

                const res = await response.json();
                if (res.message && res.message.file_url) {
                    const fileUrl = res.message.file_url;

                    // Update applicant_signature field on document
                    await fetch('/api/method/frappe.client.set_value', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'X-Frappe-CSRF-Token': getCookie('csrf_token')
                        },
                        body: JSON.stringify({
                            doctype: 'Passport Application',
                            name: docname,
                            fieldname: 'applicant_signature',
                            value: fileUrl
                        })
                    });

                    statusMsg.style.color = '#16a34a';
                    statusMsg.innerText = '✅ تم حفظ التوقيع بنجاح! جاري العودة...';

                    // Send message to parent tab to refresh
                    if (window.opener && !window.opener.closed) {
                        window.opener.postMessage({
                            type: 'PASSPORT_SIGNATURE_SAVED',
                            docname: docname,
                            file_url: fileUrl
                        }, '*');
                    }

                    setTimeout(() => {
                        window.close();
                    }, 600);
                } else {
                    throw new Error('فشل رفع الملف');
                }
            } catch (err) {
                console.error(err);
                statusMsg.style.color = '#dc2626';
                statusMsg.innerText = 'حدث خطأ أثناء حفظ التوقيع، يرجى المحاولة ثانية.';
                saveBtn.disabled = false;
            }
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return '';
        }
    </script>
</body>
</html>
"""

