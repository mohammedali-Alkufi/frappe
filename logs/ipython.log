sign_html = """<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>توقيع صاحب الجواز</title>
    <style>
        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body {
            margin: 0; padding: 20px; background: #f8fafc;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-height: 100vh;
        }
        .container {
            background: #ffffff; padding: 24px; border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.06); width: 100%; max-width: 600px; text-align: center;
            border: 1px solid #e2e8f0;
        }
        h2 { margin-top: 0; color: #0f172a; font-size: 19px; }
        p { color: #64748b; font-size: 13.5px; margin-bottom: 16px; }
        .canvas-box {
            border: 2px dashed #94a3b8; border-radius: 8px; background: #fff;
            position: relative; touch-action: none;
        }
        canvas { width: 100%; height: 220px; display: block; cursor: crosshair; }
        .btn-group { display: flex; gap: 10px; margin-top: 18px; justify-content: center; }
        button {
            padding: 9px 18px; font-size: 14px; font-weight: 600; border-radius: 6px; border: none; cursor: pointer;
        }
        .btn-save { background: #15803d; color: #ffffff; }
        .btn-save:hover { background: #166534; }
        .btn-clear { background: #e2e8f0; color: #334155; }
        .btn-cancel { background: #fee2e2; color: #991b1b; }
        #msg { margin-top: 12px; font-size: 13.5px; font-weight: 600; min-height: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>لوحة التوقيع الرقمي (Signature Pad)</h2>
        <p>يرجى كتابة التوقيع داخل المستطيل أدناه ثم الضغط على "حفظ التوقيع والعودة"</p>

        <div class="canvas-box">
            <canvas id="sig-canvas" width="580" height="220"></canvas>
        </div>

        <div id="msg"></div>

        <div class="btn-group">
            <button class="btn-save" id="btn-save" onclick="save()">💾 حفظ التوقيع والعودة</button>
            <button class="btn-clear" onclick="clearPad()">مسح</button>
            <button class="btn-cancel" onclick="window.close()">إغلاق</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('sig-canvas');
        const ctx = canvas.getContext('2d');
        const msg = document.getElementById('msg');
        let isDrawing = false;
        let drawn = false;

        ctx.strokeStyle = '#000000';
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (cx - rect.left) * (canvas.width / rect.width),
                y: (cy - rect.top) * (canvas.height / rect.height)
            };
        }

        function start(e) {
            e.preventDefault();
            isDrawing = true;
            drawn = true;
            const p = getPos(e);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
        }

        function draw(e) {
            if (!isDrawing) return;
            e.preventDefault();
            const p = getPos(e);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
        }

        function stop(e) {
            if (isDrawing) {
                isDrawing = false;
                ctx.closePath();
            }
        }

        canvas.addEventListener('mousedown', start);
        canvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stop);

        canvas.addEventListener('touchstart', start, { passive: false });
        canvas.addEventListener('touchmove', draw, { passive: false });
        canvas.addEventListener('touchend', stop);

        function clearPad() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawn = false;
            msg.innerText = '';
        }

        function getCookie(name) {
            let cookieArr = document.cookie.split(";");
            for(let i = 0; i < cookieArr.length; i++) {
                let cookiePair = cookieArr[i].trim();
                if (cookiePair.startsWith(name + "=")) {
                    return decodeURIComponent(cookiePair.substring(name.length + 1));
                }
            }
            return "";
        }

        async function save() {
            if (!drawn) {
                alert('يرجى رسم التوقيع أولاً');
                return;
            }

            const params = new URLSearchParams(window.location.search);
            const docname = params.get('docname');
            if (!docname) {
                alert('اسم المستند غير موجود');
                return;
            }

            const btn = document.getElementById('btn-save');
            btn.disabled = true;
            msg.style.color = '#0284c7';
            msg.innerText = 'جاري حفظ التوقيع...';

            const dataUrl = canvas.toDataURL('image/png');
            const csrfToken = getCookie('csrf_token') || '{{ frappe.session.csrf_token }}';

            try {
                const formData = new FormData();
                formData.append('docname', docname);
                formData.append('image_data', dataUrl);

                const res = await fetch('/api/method/passport_system.passport_system.doctype.passport_application.passport_application.upload_applicant_signature', {
                    method: 'POST',
                    headers: {
                        'X-Frappe-CSRF-Token': csrfToken
                    },
                    body: formData
                });

                const data = await res.json();
                if (data.message && data.message.file_url) {
                    msg.style.color = '#15803d';
                    msg.innerText = '✅ تم الحفظ بنجاح!';

                    if (window.opener && !window.opener.closed) {
                        window.opener.postMessage({
                            type: 'PASSPORT_SIGNATURE_SAVED',
                            docname: docname,
                            file_url: data.message.file_url
                        }, '*');
                    }

                    setTimeout(() => window.close(), 600);
                } else {
                    throw new Error(data.exc || 'فشل حفظ الملف');
                }
            } catch (err) {
                console.error(err);
                msg.style.color = '#b91c1c';
                msg.innerText = 'خطأ أثناء الحفظ. يرجى المحاولة ثانية.';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
"""

