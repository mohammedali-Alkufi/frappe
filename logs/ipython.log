enhanced_method = '''
@frappe.whitelist()
def upload_applicant_signature(docname, image_data):
    if not docname or not image_data:
        frappe.throw("Missing parameters")
    
    import base64
    import io
    from PIL import Image
    from frappe.utils.file_manager import save_file

    if "," in image_data:
        image_data = image_data.split(",")[1]

    raw_bytes = base64.b64decode(image_data)
    img = Image.open(io.BytesIO(raw_bytes)).convert("RGBA")

    # Turn any white/near-white pixels into 100% transparent alpha
    datas = img.getdata()
    new_data = []
    for item in datas:
        # If pixel is close to white (RGB > 215), set alpha = 0
        if item[0] > 215 and item[1] > 215 and item[2] > 215:
            new_data.append((255, 255, 255, 0))
        else:
            new_data.append(item)
    img.putdata(new_data)

    output = io.BytesIO()
    img.save(output, format="PNG")
    clean_bytes = output.getvalue()

    file_name = f"sig_{docname.replace(' ', '_')}.png"
    file_doc = save_file(
        fname=file_name,
        content=clean_bytes,
        dt="Passport Application",
        dn=docname,
        is_private=0
    )

    frappe.db.set_value("Passport Application", docname, "applicant_signature", file_doc.file_url)
    frappe.db.commit()
    return {"file_url": file_doc.file_url}
