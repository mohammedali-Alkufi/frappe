import os

# ============================================================
# 1. ADD WHITELISTED SERVER METHOD FOR SIGNATURE UPLOAD
# ============================================================
py_path = frappe.get_app_path("passport_system", "passport_system", "doctype", "passport_application", "passport_application.py")

with open(py_path, "r") as f:
    content = f.read()

method_code = '''
@frappe.whitelist()
def upload_applicant_signature(docname, image_data):
    if not docname or not image_data:
        frappe.throw("Missing parameters")
    
    import base64
    from frappe.utils.file_manager import save_file

    if "," in image_data:
        image_data = image_data.split(",")[1]

    file_bytes = base64.b64decode(image_data)
    file_name = f"sig_{docname.replace(' ', '_')}.png"

    file_doc = save_file(
        fname=file_name,
        content=file_bytes,
        dt="Passport Application",
        dn=docname,
        is_private=0
    )

    frappe.db.set_value("Passport Application", docname, "applicant_signature", file_doc.file_url)
    frappe.db.commit()
    return {"file_url": file_doc.file_url}
'''

if "def upload_applicant_signature" not in content:
    with open(py_path, "a") as f:
        f.write("\n\n" + method_code)
    print(">>> [OK] Appended upload_applicant_signature endpoint.")

